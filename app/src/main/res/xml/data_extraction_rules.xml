<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 and newer (Requirement 16.2: no user data leaves the device
  without the user's consent).

  Cloud backup: nothing is uploaded. The database holds transcripts and hearing profiles, and
  the files folder holds the SOS contacts and the lecture recordings.

  Device transfer (phone to phone, directly): settings and profiles move across, but the lecture
  recordings stay behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="classroom_audio" />
    </device-transfer>
</data-extraction-rules>
