<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 and older (Requirement 16.2: no user data leaves the device
  without the user's consent). Transcripts, lecture recordings, hearing profiles and the SOS
  contacts live in these three places, so none of them is included in the cloud backup.
  Android 12 and newer use data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
